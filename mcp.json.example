{
  "mcpServers": {
    "paperless": {
      "command": "paperless-mcp",
      "args": [],
      "env": {
        "PAPERLESS_BASE_URL": "http://paperless.example.net:8000",
        "PAPERLESS_API_TOKEN": "${PAPERLESS_API_TOKEN}"
      }
    },
    "internal-only": {
      "command": "some-python-mcp",
      "args": [],
      "hub": false
    },
    "untrusted": {
      "type": "docker",
      "image": "ghcr.io/example/untrusted-mcp:1.2.3",
      "env": { "SOME_SETTING": "value" },
      "secretsFrom": "untrusted",
      "network": "none",
      "memory": "256m"
    },
    "sidecar": {
      "type": "unix",
      "socket": "/run/mcp/sidecar.sock"
    }
  }
}
